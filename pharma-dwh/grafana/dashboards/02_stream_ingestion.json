{
  "uid": "dwh-stream",
  "title": "2 - Streaming Ingestion (IoT micro-batches)",
  "description": "",
  "tags": [
    "pharma_dwh",
    "data-engineering"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "run_label",
        "label": "Stream run",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "pharma-pg"
        },
        "query": "SELECT DISTINCT run_label FROM meta.stream_metrics ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**Streaming ingestion** - the stream simulator emits sensor readings in micro-batches to `POST /ingest/stream`. Latency = DB insert timestamp - source row creation timestamp. One row per micro-batch window in `meta.stream_metrics`."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Stream Throughput (events/s)",
      "description": "Total records ingested / total stream duration (s)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT sum(events_loaded)/NULLIF(extract(epoch FROM max(window_end)-min(window_start)),0)\n         FROM meta.stream_metrics WHERE run_label IN (${run_label:sqlstring})"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Events ingested",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 5,
        "y": 2,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT sum(events_loaded) FROM meta.stream_metrics WHERE run_label IN (${run_label:sqlstring})"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
