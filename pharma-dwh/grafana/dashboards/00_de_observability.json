      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT refresh_label, object_name, rows_before, rows_after, rows_inserted, status, finished_at\n         FROM meta.mart_refresh_log WHERE object_name LIKE 'sdi.fact%' OR object_name='BI refresh signal'\n         ORDER BY refresh_id DESC"
