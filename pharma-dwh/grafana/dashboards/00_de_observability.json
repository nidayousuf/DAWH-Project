      },
      "options": {
        "mode": "markdown",
        "content": "## Pharma Cold-Chain DWH - Data Engineering Observability\nPipeline: **Generator -> Landing -> File-watcher -> Ingestion API -> Postgres ODS -> DuckDB SDI star schema -> Postgres `sdi` -> Power BI**, orchestrated by Airflow.\n\nOpen the four detail dashboards from the *All Pharma DWH dashboards* menu (top right)."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Batch success rate",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 100.0*count(*) FILTER (WHERE status IN ('SUCCESS','PARTIAL'))/NULLIF(count(*),0) FROM meta.batch_ingestion_log WHERE status<>'RUNNING'"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Stream throughput (eps)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT sum(events_loaded)/NULLIF(extract(epoch FROM max(window_end)-min(window_start)),0) FROM meta.stream_metrics"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
