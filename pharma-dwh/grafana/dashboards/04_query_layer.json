{
  "uid": "dwh-query",
  "title": "4 - Analytical Query Layer & Optimisation",
  "description": "",
  "tags": [
    "pharma_dwh",
    "data-engineering"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "refresh_label",
        "label": "Refresh",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "pharma-pg"
        },
        "query": "SELECT DISTINCT refresh_label FROM meta.query_log WHERE refresh_label IS NOT NULL ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "definition": "",
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**Query layer** - every dashboard widget's SQL is run against the star schema (*base_star*) and against the pre-aggregated summary tables (*optimized_aggregate*), timed with a `time.perf_counter()` wrapper and logged to `meta.query_log`."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Queries executed",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM meta.query_log WHERE refresh_label IN (${refresh_label:sqlstring})"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Query Error Rate",
      "description": "Failed / total executed x 100 (includes one deliberate negative test)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 5,
        "y": 2,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 100.0*count(*) FILTER (WHERE status='FAILED')/NULLIF(count(*),0) FROM meta.query_log WHERE refresh_label IN (${refresh_label:sqlstring})"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg execution time",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 10,
        "y": 2,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT avg(duration_ms) FROM meta.query_log WHERE refresh_label IN (${refresh_label:sqlstring}) AND status='SUCCESS'"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ms",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "p95 execution time",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 15,
        "y": 2,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms) FROM meta.query_log WHERE refresh_label IN (${refresh_label:sqlstring}) AND status='SUCCESS'"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "ms",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 500
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Speed-up from aggregates",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 19,
        "y": 2,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT avg(duration_ms) FILTER (WHERE query_variant='base_star')/NULLIF(avg(duration_ms) FILTER (WHERE query_variant='optimized_aggregate'),0)\n         FROM meta.query_log WHERE refresh_label IN (${refresh_label:sqlstring}) AND status='SUCCESS' AND query_name IN (SELECT query_name FROM meta.query_log WHERE query_variant='optimized_aggregate')"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "x",
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Average Query Execution Time (ms) per dashboard widget",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT query_name,\n            avg(duration_ms) FILTER (WHERE query_variant='base_star') AS \"star schema\",\n            avg(duration_ms) FILTER (WHERE query_variant='optimized_aggregate') AS \"pre-aggregated\"\n         FROM meta.query_log WHERE refresh_label IN (${refresh_label:sqlstring}) AND status='SUCCESS' GROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "orientation": "vertical",
        "showValue": "auto",
        "stacking": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "xTickLabelRotation": -30,
        "barWidth": 0.8,
        "groupWidth": 0.7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Daily Active Query Count",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT to_char(executed_at,'YYYY-MM-DD') AS day, count(*) FILTER (WHERE status='SUCCESS') AS succeeded,\n            count(*) FILTER (WHERE status='FAILED') AS failed FROM meta.query_log WHERE refresh_label IN (${refresh_label:sqlstring}) GROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "orientation": "vertical",
        "showValue": "auto",
        "stacking": "normal",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "xTickLabelRotation": -30,
        "barWidth": 0.8,
        "groupWidth": 0.7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Execution time by refresh (data volume effect)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 17,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT refresh_label, avg(duration_ms) AS avg_ms,\n            max(duration_ms) AS max_ms FROM meta.query_log WHERE status='SUCCESS' GROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "orientation": "vertical",
        "showValue": "auto",
        "stacking": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "xTickLabelRotation": -30,
        "barWidth": 0.8,
        "groupWidth": 0.7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Failed queries",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 17,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT executed_at, query_name, widget, error_message FROM meta.query_log\n         WHERE status='FAILED' AND refresh_label IN (${refresh_label:sqlstring}) ORDER BY executed_at DESC"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    }
  ],
