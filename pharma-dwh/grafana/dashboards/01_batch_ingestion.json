  "refresh": "10s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "refresh_label",
        "label": "Refresh",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "pharma-pg"
        },
        "query": "SELECT DISTINCT refresh_label FROM meta.batch_ingestion_log WHERE refresh_label IS NOT NULL ORDER BY 1",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "definition": "",
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**Batch ingestion** - every file dropped in `data/landing` is picked up by the file-watcher, posted to the ingestion API, validated and COPY-loaded into Postgres staging. One row per load in `meta.batch_ingestion_log`."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Batch Success Rate",
      "description": "Successful runs / total attempted runs x 100 (PARTIAL = finished, some rows rejected)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 100.0*count(*) FILTER (WHERE status IN ('SUCCESS','PARTIAL'))/NULLIF(count(*),0) FROM meta.batch_ingestion_log WHERE refresh_label IN (${refresh_label:sqlstring}) AND status<>'RUNNING'"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
