    {
      "id": 8,
      "type": "barchart",
      "title": "Batch Load Duration (s) per source file",
      "description": "Timestamp_end - Timestamp_start per file, split into read / validate / insert phases",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT regexp_replace(file_name,'(__.*)?\\.csv$','') || ' [' || refresh_label || ']' AS file,\n            read_seconds AS \"read\", validate_seconds AS \"validate\", insert_seconds AS \"insert\"\n         FROM meta.batch_ingestion_log WHERE refresh_label IN (${refresh_label:sqlstring}) AND status<>'RUNNING' ORDER BY duration_seconds DESC"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "normal",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "xTickLabelRotation": 0,
        "barWidth": 0.8,
        "groupWidth": 0.7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
