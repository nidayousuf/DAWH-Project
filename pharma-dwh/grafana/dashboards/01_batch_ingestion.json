          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT regexp_replace(file_name,'(__.*)?\\.csv$','') || ' [' || refresh_label || ']' AS file,\n            rows_loaded AS loaded, rows_rejected AS rejected, rows_skipped AS skipped\n         FROM meta.batch_ingestion_log WHERE refresh_label IN (${refresh_label:sqlstring}) AND status<>'RUNNING' ORDER BY rows_read DESC"
        }
      ],
      "options": {
        "orientation": "horizontal",
