      "id": 9,
      "type": "barchart",
      "title": "Rows Processed per Batch (len(df))",
      "description": "Rows read from each file, split into loaded / rejected / skipped (already staged)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 12,
