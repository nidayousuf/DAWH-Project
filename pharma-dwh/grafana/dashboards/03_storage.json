    {
      "id": 9,
      "type": "barchart",
      "title": "Table row count growth across refreshes (staging)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT refresh_label, sum(row_count) FILTER (WHERE source_domain='Pharmacy sales') AS \"Pharmacy sales\",\n            sum(row_count) FILTER (WHERE source_domain='Warehouse') AS \"Warehouse\",\n            sum(row_count) FILTER (WHERE source_domain='IoT telemetry') AS \"IoT telemetry\",\n            sum(row_count) FILTER (WHERE source_domain='Hospital demand') AS \"Hospital demand\"\n         FROM meta.storage_metrics m WHERE layer='staging' AND captured_at = (SELECT max(captured_at) FROM meta.storage_metrics x WHERE x.refresh_label=m.refresh_label)\n         GROUP BY 1 ORDER BY min(captured_at)"
        }
      ],
      "options": {
        "orientation": "vertical",
        "showValue": "auto",
        "stacking": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
