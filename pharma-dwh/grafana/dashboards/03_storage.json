    {
      "id": 11,
      "type": "table",
      "title": "Date Coverage Span check (2023 -> latest refresh)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pharma-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pharma-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT object_name, min_date, max_date, date_span_days,\n            distinct_months, CASE WHEN min_date <= '2023-02-01' AND distinct_months >= 36 THEN 'OK - full 2023-2025 coverage' ELSE 'CHECK' END AS coverage\n         FROM meta.storage_metrics WHERE captured_at = (SELECT max(captured_at) FROM meta.storage_metrics) AND min_date IS NOT NULL ORDER BY object_name"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
